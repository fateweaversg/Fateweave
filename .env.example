# FateWeave server — copy to .env and fill in. NEVER commit .env with real values.
# See DEPLOY-CHECKLIST.md for what Jason must supply.

# Server
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./data/fateweave.db

# Stripe (primary payment provider) — from https://dashboard.stripe.com
# Test keys start sk_test_ / pk_test_ ; live keys start sk_live_ / pk_live_
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices in cents, USD. Launch unlock $2.99 = 299, regular unlock $8 = 800.
PROMO_PRICE_CENTS=299
FULL_PRICE_CENTS=800
# Optional: set a private high-entropy code to grant one complimentary reading per email + birth date.
PROMO_ACCESS_CODE=
PROMO_ACCESS_MAX_REDEMPTIONS=10
MASTER_CHAT_5_PACK_PRICE_CENTS=199
MASTER_CHAT_10_PACK_PRICE_CENTS=349
# Promo window, SGT dates inclusive (decided 7 Nov 2026)
PROMO_START=2026-11-07
PROMO_END=2026-11-24

# Email — use Resend if RESEND_API_KEY is set, otherwise SMTP via nodemailer.
# If neither is set, emails are logged to the console (dev fallback only — do NOT launch like this).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@fateweave.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@fateweave.example
# Temporary: exactly two recipients for the owner-only SMTP delivery check.
# Remove from Railway after the one-off test; keep blank for normal operation.
EMAIL_TEST_RECIPIENTS=

# HitPay (optional alternative, SG PayNow + cards) — Stripe is primary.
# Do NOT set these unless HitPay is configured; the HitPay webhook stub returns 400 without them.
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SECRET=

# Owner access — server-checked only. No owner link is shown publicly.
# Generate with: npm run hash-owner-password
# Example format: $2b$12$...
OWNER_PASSWORD_HASH=
OWNER_EMAIL=owner@example.com

# Access token lifetime for paid buyers (days). Same buyer revisits with same email + birth date + token.
ACCESS_TOKEN_DAYS=90

# Optional comma-separated Gemini failover models; leave empty to disable failover.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite
